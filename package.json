{
  "name": "podcaststeam",
  "version": "0.1.0",
  "private": true,
  "description": "Reproductor de podcasts RSS para escuchar mientras juegas",
  "author": "PodcastSteam",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.podcaststeam.player",
    "productName": "PodcastSteam",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
